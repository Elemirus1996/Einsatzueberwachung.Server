[Unit]
Description=Einsatzueberwachung Backup ausfuehren
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/einsatzueberwachung/scripts/backup.sh
# Als App-Benutzer, damit Backups in Einstellungen → Wartung geloescht werden koennen
User=einsatz
Group=einsatz
Environment=RETENTION_COUNT=5
Environment=MIN_FREE_GB=15
