[Unit]
Description=Einsatzueberwachung Server
After=network.target

[Service]
WorkingDirectory=/opt/einsatzueberwachung/server
ExecStart=/usr/bin/dotnet Einsatzueberwachung.Server.dll
Restart=always
RestartSec=10
SyslogIdentifier=einsatzueberwachung-server
User=einsatz
Environment=ASPNETCORE_ENVIRONMENT=Production
# 5000 = VPN (Nginx-Block einsatzueberwachung.conf), 5002 = oeffentlicher Team-Zugang (einsatzueberwachung-public.conf).
# Auf Port 5002 sind nur die Team-Seiten erreichbar. Ohne EINSATZUEBERWACHUNG_PUBLIC_PORT gilt 5002 als intern –
# beide Zeilen deshalb immer gemeinsam aendern.
Environment="ASPNETCORE_URLS=http://127.0.0.1:5000;http://127.0.0.1:5002"
Environment=EINSATZUEBERWACHUNG_PUBLIC_PORT=5002
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
# Optional: erforderlich bei privatem GitHub-Repository fuer Update-Pruefung
# Environment=EINSATZUEBERWACHUNG_GITHUB_TOKEN=<PAT_mit_repo_scope>
Environment=EINSATZUEBERWACHUNG_DATA_DIR=/opt/einsatzueberwachung/data
Environment=EINSATZUEBERWACHUNG_REPORT_DIR=/opt/einsatzueberwachung/data/berichte
Environment="EINSATZUEBERWACHUNG_UPDATE_APPLY_CMD=/opt/einsatzueberwachung/scripts/apply-update.sh '{package}' '{version}'"

[Install]
WantedBy=multi-user.target
