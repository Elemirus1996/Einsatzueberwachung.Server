[Interface]
# Netz 10.10.0.0/24 – muss zu "allow 10.10.0.0/24" in deploy/nginx/einsatzueberwachung.conf passen
Address = 10.10.0.1/24
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>

# Client: Einsatzleitung Laptop
[Peer]
PublicKey = <CLIENT_LAPTOP_PUBLIC_KEY>
AllowedIPs = 10.10.0.2/32

# Client: Einsatzkraft Smartphone
[Peer]
PublicKey = <CLIENT_PHONE_PUBLIC_KEY>
AllowedIPs = 10.10.0.3/32
