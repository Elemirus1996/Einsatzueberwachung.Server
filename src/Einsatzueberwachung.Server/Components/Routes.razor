@rendermode InteractiveServer
@using Einsatzueberwachung.Server.Security

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (PublicOnly && !PublicAccess.IsPublicPage(routeData.PageType))
        {
            @* Oeffentlicher Team-Zugang: andere Seiten auch bei Navigation im Circuit nicht rendern *@
            <LayoutView Layout="typeof(Layout.TeamMobileLayout)">
                <PageTitle>Nicht verfügbar</PageTitle>
                <div class="container py-5 text-center">
                    <p class="mb-3">Diese Seite ist über den öffentlichen Team-Zugang nicht verfügbar.</p>
                    <a href="/team/login" class="btn btn-primary">Zur Team-Anmeldung</a>
                </div>
            </LayoutView>
        }
        else if (!LeitungAccess.IsAnonymousPage(routeData.PageType) && !LeitungAuth.IsLeitung(_user))
        {
            @* Alle Seiten der Einsatzleitung nur nach Anmeldung – auch bei Navigation im Circuit *@
            <Einsatzueberwachung.Server.Components.Shared.RedirectToLeitungLogin />
        }
        else
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
</Router>

@code {
    /// <summary>
    /// Circuit wurde ueber den oeffentlichen Port aufgebaut. Der Wert kommt beim ersten Seitenaufruf aus App.razor
    /// und steckt signiert im Komponenten-Marker – der Browser kann ihn nicht aendern.
    /// </summary>
    [Parameter] public bool PublicOnly { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private System.Security.Claims.ClaimsPrincipal? _user;

    protected override async Task OnParametersSetAsync()
    {
        // Wird bei jeder Aenderung des Anmeldestatus neu gesetzt (z.B. Passwort geaendert → abgemeldet)
        _user = AuthenticationState is null ? null : (await AuthenticationState).User;
    }
}
