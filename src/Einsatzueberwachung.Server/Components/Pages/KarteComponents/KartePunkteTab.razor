@* Koordinaten-Marker-Tab-Panel der Karten-Sidebar *@

<div class="sidebar-content-header">
    <span class="small fw-semibold"><i class="bi bi-crosshair me-1"></i>Punkte</span>
    <div class="d-flex gap-1 align-items-center">
        <button class="btn btn-xs btn-outline-secondary"
                @onclick="() => OnSetElwPosition.InvokeAsync()"
                title="@(HasElwPosition ? "ELW verschieben" : "ELW setzen")">
            <i class="bi bi-geo-fill">ELW</i>
        </button>
        @if (Markers.Any())
        {
            <button class="btn btn-xs btn-link p-0" @onclick="DownloadAllMarkersGpx" title="Alle als GPX exportieren">
                <i class="bi bi-download"></i>
            </button>
        }
        <button class="btn btn-xs tab-toggle-btn @(_inputOpen ? "is-active" : "btn-primary")"
                @onclick="ToggleInputPanel"
                title="@(_inputOpen ? "Eingabe schlie\xDFen" : "Punkt eintragen")">
            <i class="bi bi-plus-lg toggle-icon"></i>
        </button>
    </div>
</div>

<div class="sidebar-list points-tab-content">

    @* Eingabe-Bereich *@
    @if (_inputOpen)
    {
    <div class="marker-input-section">
        <div class="marker-input-tabs">
        <button class="btn btn-xs @(_mode == "click" ? "btn-primary" : "btn-outline-primary")"
                @onclick="ActivateClickToPlaceModeAsync"
                title="Punkt per Mausklick auf Karte setzen">
            <i class="bi bi-cursor-fill"></i> Klick
        </button>
        <button class="btn btn-xs @(_mode == "latlong" ? "btn-primary" : "btn-outline-primary")"
                @onclick='@(() => SetCoordInputModeAsync("latlong"))'>
            <i class="bi bi-geo"></i> Lat/Long
        </button>
        <button class="btn btn-xs @(_mode == "utm" ? "btn-primary" : "btn-outline-primary")"
                @onclick='@(() => SetCoordInputModeAsync("utm"))'>
            <i class="bi bi-grid-3x3"></i> UTM
        </button>
        </div>

        @if (_mode == "click")
        {
            <div class="mt-2">
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width:35px"><i class="bi bi-tag"></i></span>
                    <input type="text" class="form-control" @bind="_inputMarkerLabel" @bind:event="oninput"
                           placeholder="Bezeichnung (optional)" />
                </div>
                @if (ClickToPlaceActive)
                {
                    <div class="alert alert-info py-1 px-2 small mb-0">
                        <i class="bi bi-cursor-fill me-1"></i>Auf die Karte klicken um Punkt zu setzen
                    </div>
                }
            </div>
        }
        else if (_mode == "latlong")
        {
            <div class="marker-coord-input mt-2">
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width:35px">Lat</span>
                    <input type="text" class="form-control" @bind="_inputLatitude" placeholder="z.B. 49.31880" />
                </div>
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width:35px">Lng</span>
                    <input type="text" class="form-control" @bind="_inputLongitude" placeholder="z.B. 8.43120" />
                </div>
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width:35px"><i class="bi bi-tag"></i></span>
                    <input type="text" class="form-control" @bind="_inputMarkerLabel" placeholder="Bezeichnung (optional)" />
                </div>
                <button class="btn btn-sm btn-success w-100" @onclick="PlaceMarkerFromLatLong">
                    <i class="bi bi-pin-map"></i> Punkt setzen
                </button>
            </div>
        }
        else if (_mode == "utm")
        {
            <div class="marker-coord-input mt-2">
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width:50px">UTM</span>
                    <input type="text" class="form-control" @bind="_inputUtm" placeholder="z.B. 32U 461344 5481745" />
                </div>
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text" style="min-width:50px"><i class="bi bi-tag"></i></span>
                    <input type="text" class="form-control" @bind="_inputMarkerLabel" placeholder="Bezeichnung (optional)" />
                </div>
                <button class="btn btn-sm btn-success w-100" @onclick="PlaceMarkerFromUtm">
                    <i class="bi bi-pin-map"></i> Punkt setzen
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_markerMessage))
        {
            <div class="alert @(_markerMessageType) py-1 px-2 mt-2 mb-0 small">@_markerMessage</div>
        }
    </div>
    }

    @* Liste der Marker *@
    <div class="sidebar-section-header">
        <span>Gesetzte Punkte</span>
        <span class="badge bg-secondary">@Markers.Count</span>
    </div>
    @if (Markers.Any())
    {
        <div class="marker-list">
            @foreach (var marker in Markers.OrderByDescending(m => m.CreatedAt))
            {
                <div class="sidebar-card-item"
                     role="button"
                     tabindex="0"
                     title="Zum Punkt zoomen"
                     @onkeydown='async e => { if (e.Key == "Enter" || e.Key == " ") await ZoomToMarker(marker); }'
                     @onclick="() => ZoomToMarker(marker)">
                    <div class="card-header-row">
                        <i class="bi bi-pin-map-fill card-icon" style="color: @marker.Color;"></i>
                        <span class="card-title">@(string.IsNullOrEmpty(marker.Label) ? $"Punkt {marker.FormattedTimestamp}" : marker.Label)</span>
                    </div>
                    <div class="card-info-row">
                        <small class="text-muted">@marker.FormattedLatLng</small>
                        @if (!string.IsNullOrEmpty(marker.FormattedUtm))
                        {
                            <small class="text-muted">@marker.FormattedUtm</small>
                        }
                    </div>
                    <div class="card-actions">
                        <button class="btn btn-xs btn-link" @onclick:stopPropagation="true" @onclick="() => ZeigeZielSenden(marker)" title="An Team senden">
                            <i class="bi bi-send"></i>
                        </button>
                        <button class="btn btn-xs btn-link" @onclick:stopPropagation="true" @onclick="() => ZeigeNavigationsQr(marker)" title="QR-Code zur Navigation">
                            <i class="bi bi-qr-code"></i>
                        </button>
                        <button class="btn btn-xs btn-link" @onclick:stopPropagation="true" @onclick="() => HinspringenZuMarker(marker)" title="Hinspringen">
                            <i class="bi bi-crosshair"></i>
                        </button>
                        <button class="btn btn-xs btn-link" @onclick:stopPropagation="true" @onclick="() => ZoomToMarker(marker)" title="Zoomen">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        <button class="btn btn-xs btn-link" @onclick:stopPropagation="true" @onclick="() => StartEditMarker(marker)" title="Bearbeiten">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-xs btn-link" @onclick:stopPropagation="true" @onclick="() => DownloadMarkerGpx(marker)" title="GPX">
                            <i class="bi bi-download"></i>
                        </button>
                        <button class="btn btn-xs btn-link text-secondary" @onclick:stopPropagation="true" @onclick="() => RemoveMarker(marker)" title="Entfernen">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="marker-list-empty">
            <small class="text-muted">Keine Punkte gesetzt</small>
        </div>
    }
</div>

@* Marker-Edit-Dialog (an Komponenten-Root, da Modal Position: fixed nutzt) *@
@if (_showMarkerEditDialog)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> Marker bearbeiten</h5>
                    <button type="button" class="btn-close" @onclick="CloseMarkerEditDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Bezeichnung</label>
                        <input type="text" class="form-control" @bind="_editMarkerLabel" @bind:event="oninput"
                               placeholder="Bezeichnung" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Koordinaten (Lat/Long)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Lat</span>
                                    <input type="text" class="form-control" value="@_editMarkerLat"
                                           @oninput="OnEditLatChanged" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Lng</span>
                                    <input type="text" class="form-control" value="@_editMarkerLng"
                                           @oninput="OnEditLngChanged" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">UTM-Koordinaten</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">UTM</span>
                            <input type="text" class="form-control" value="@_editMarkerUtm"
                                   @oninput="OnEditUtmChanged"
                                   placeholder="z.B. 32U 461344 5481745" />
                        </div>
                        <small class="text-muted">Änderungen werden automatisch zwischen Lat/Long und UTM synchronisiert.</small>
                    </div>

                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="StartMarkerDragMode">
                            <i class="bi bi-arrows-move"></i> Position per Drag auf der Karte ändern
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(_editMarkerMessage))
                    {
                        <div class="alert @(_editMarkerMessageType) py-1 px-2 mt-2 mb-0">
                            <small>@_editMarkerMessage</small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMarkerEditDialog">Abbrechen</button>
                    <button type="button" class="btn btn-success" @onclick="SaveMarkerEdit">
                        <i class="bi bi-check-lg"></i> Speichern
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Punkt als Navigationsziel an ein Team (Variante C): Die Team-App zeigt „Navigation starten“ *@
@if (_zielMarker is { } zielPunkt)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-send"></i> „@(string.IsNullOrEmpty(zielPunkt.Label) ? $"Punkt {zielPunkt.FormattedTimestamp}" : zielPunkt.Label)“ an Team senden</h5>
                    <button type="button" class="btn-close" @onclick="SchliesseZielSenden"></button>
                </div>
                <div class="modal-body">
                    @if (ZielTeams.Count == 0)
                    {
                        <p class="text-muted mb-0">Im Einsatz gibt es noch keine Teams.</p>
                    }
                    else
                    {
                        <label class="form-label" for="ziel-team">Team</label>
                        <select id="ziel-team" class="form-select" @bind="_zielTeamId">
                            <option value="">Team wählen …</option>
                            @foreach (var team in ZielTeams)
                            {
                                <option value="@team.TeamId">@team.TeamName</option>
                            }
                        </select>
                        <p class="small text-muted mt-2 mb-0">Das Team bekommt den Punkt als Mitteilung. In der App startet es damit die Navigation.</p>
                    }
                    @if (!string.IsNullOrEmpty(_zielMeldung))
                    {
                        <div class="alert @_zielMeldungKlasse py-2 mt-3 mb-0 small">@_zielMeldung</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="SchliesseZielSenden">Schließen</button>
                    <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrEmpty(_zielTeamId) || _zielSendet)" @onclick="SendeZiel">
                        <i class="bi bi-send"></i> Senden
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* QR-Code zur Navigation (Variante A, Wunsch 31.10.2026): Team scannt mit der Kamera, das Handy öffnet die Navigation *@
@if (_navMarker is { } nav)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-qr-code"></i> Navigation zu „@(string.IsNullOrEmpty(nav.Label) ? $"Punkt {nav.FormattedTimestamp}" : nav.Label)“</h5>
                    <button type="button" class="btn-close" @onclick="SchliesseNavigationsQr"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center">
                        <div class="btn-group mb-3" role="group" aria-label="Handy wählen">
                            <button type="button" class="btn @(_navIphone ? "btn-outline-primary" : "btn-primary")" @onclick="() => _navIphone = false">
                                <i class="bi bi-android2"></i> Android
                            </button>
                            <button type="button" class="btn @(_navIphone ? "btn-primary" : "btn-outline-primary")" @onclick="() => _navIphone = true">
                                <i class="bi bi-apple"></i> iPhone
                            </button>
                        </div>
                        <img src="@(_navIphone ? _navQrApple : _navQrGeo)" alt="QR-Code für @(_navIphone ? "iPhone" : "Android")"
                             class="img-fluid d-block mx-auto" style="max-width: 320px;" />
                        <small class="text-muted">@(_navIphone ? "Öffnet Apple Karten" : "Navi-App zur Auswahl, auch offline")</small>
                    </div>
                    <div class="mt-3 small text-center">
                        <div>@nav.FormattedLatLng</div>
                        @if (!string.IsNullOrEmpty(nav.FormattedUtm))
                        {
                            <div>@nav.FormattedUtm</div>
                        }
                    </div>
                    <p class="small text-muted mt-2 mb-0">Mit der Kamera des Handys scannen. Ohne Netz zeigt die Navi-App das Ziel nur mit Offline-Karten an.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="SchliesseNavigationsQr">Schließen</button>
                </div>
            </div>
        </div>
    </div>
}
