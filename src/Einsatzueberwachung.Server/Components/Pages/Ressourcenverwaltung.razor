@page "/ressourcenverwaltung"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Einsatzueberwachung.Domain.Models
@using Einsatzueberwachung.Domain.Models.Enums
@using Einsatzueberwachung.Server.Components.Shared

<PageTitle>Ressourcenverwaltung</PageTitle>

<main class="resource-page">
    <header class="resource-page-header">
        <div>
            <p class="resource-eyebrow">EINSATZKRÄFTE UND HUNDE</p>
            <h1>Ressourcenverwaltung</h1>
            <p class="resource-intro">Personen und Hunde für den laufenden Einsatz einchecken und disponieren.</p>
        </div>
        @if (HasActiveEinsatz)
        {
            <a class="btn btn-outline-secondary resource-monitor-link" href="/einsatz-monitor">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                <span>Zum Einsatzmonitor</span>
            </a>
        }
    </header>

    @if (!HasActiveEinsatz)
    {
        <section class="resource-empty-state" role="status">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <div>
                <h2>Kein Einsatz aktiv</h2>
                <p>Die Ressourcenverwaltung steht nur während eines laufenden Einsatzes zur Verfügung.</p>
                <a class="btn btn-primary" href="/einsatz-start">Einsatz starten</a>
            </div>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @(_messageIsError ? "alert-warning" : "alert-success")" role="status">
                @_message
            </div>
        }

        <section class="resource-checkin-section" aria-labelledby="checkin-heading">
            <div class="resource-checkin-summary">
                <div>
                    <p class="resource-eyebrow">AUFNAHME</p>
                    <h2 id="checkin-heading">Check-in</h2>
                    <p class="resource-search-hint">
                        @SortedResources.Count eingecheckt
                        <span aria-hidden="true">·</span>
                        @CheckInCandidates.Count @(_searchType == ResourceEntityType.Person ? "Personen" : "Hunde") in der Liste
                    </p>
                </div>
                <button type="button"
                        class="btn btn-outline-secondary resource-checkin-toggle"
                        aria-expanded="@_checkInExpanded"
                        aria-controls="checkin-controls"
                        @onclick="ToggleCheckIn">
                    <i class="bi @(_checkInExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i>
                    @(_checkInExpanded ? "Check-in schließen" : "Weitere Ressourcen einchecken")
                </button>
            </div>

            @if (_checkInExpanded)
            {
                <div id="checkin-controls" class="resource-checkin-controls">
                    <div class="resource-checkin-toolbar">
                        <div class="resource-type-switch" role="group" aria-label="Ressourcenart auswählen">
                            <button type="button"
                                    class="btn @(_searchType == ResourceEntityType.Person ? "btn-primary" : "btn-outline-secondary")"
                                    aria-pressed="@(_searchType == ResourceEntityType.Person)"
                                    @onclick="() => SelectSearchType(ResourceEntityType.Person)">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                Personen
                            </button>
                            <button type="button"
                                    class="btn @(_searchType == ResourceEntityType.Dog ? "btn-primary" : "btn-outline-secondary")"
                                    aria-pressed="@(_searchType == ResourceEntityType.Dog)"
                                    @onclick="() => SelectSearchType(ResourceEntityType.Dog)">
                                <i class="bi bi-shield" aria-hidden="true"></i>
                                Hunde
                            </button>
                        </div>
                        <label class="resource-initial-status">
                            <span>Startstatus</span>
                            <select class="form-select" @bind="_initialStatus">
                                <option value="@ResourceStatus.AufAnfahrt">Auf Anfahrt</option>
                                <option value="@ResourceStatus.Verfuegbar">Im Verfügungsraum</option>
                            </select>
                        </label>
                        <label class="resource-search-field">
                            <span>Liste filtern</span>
                            <span class="resource-search-input-wrap">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search"
                                       class="form-control"
                                       placeholder="@(_searchType == ResourceEntityType.Person ? "Name oder Organisation" : "Hundename oder Rasse")"
                                       autocomplete="off"
                                       @bind="_searchText"
                                       @bind:event="oninput" />
                            </span>
                        </label>
                    </div>

                    @if (CheckInCandidates.Count == 0)
                    {
                        <p class="resource-search-hint" role="status">
                            @if (string.IsNullOrWhiteSpace(_searchText))
                            {
                                @if (ActiveMasterDataCount == 0)
                                {
                                    <span>Keine aktiven Stammdaten dieser Art vorhanden.</span>
                                }
                                else
                                {
                                    <span>Alle aktiven Stammdaten dieser Art sind bereits eingecheckt.</span>
                                }
                            }
                            else
                            {
                                <span>Keine passenden, noch nicht eingecheckten Stammdaten gefunden.</span>
                            }
                        </p>
                    }
                    else
                    {
                        <div class="resource-suggestions" role="list" aria-label="@(_searchType == ResourceEntityType.Person ? "Eincheckbare Personen" : "Eincheckbare Hunde")">
                            @foreach (var suggestion in CheckInCandidates)
                            {
                                <div class="resource-suggestion" role="listitem" @key="suggestion.Id">
                                    <div class="resource-suggestion-identity">
                                        <span class="resource-kind-icon" aria-hidden="true">
                                            <i class="bi @(suggestion.EntityType == ResourceEntityType.Person ? "bi-person" : "bi-shield")"></i>
                                        </span>
                                        <span>
                                            <strong>@suggestion.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(suggestion.Detail))
                                            {
                                                <small>@suggestion.Detail</small>
                                            }
                                        </span>
                                    </div>
                                    <button type="button"
                                    class="btn btn-sm btn-primary"
                                            aria-label="@($"{suggestion.Name} einchecken")"
                                            title="@($"Mit Status „{ResourceStatusPresentation.Label(_initialStatus)}“ einchecken")"
                                            disabled="@_isSaving"
                                            @onclick="() => CheckInAsync(suggestion.EntityType, suggestion.Id)">
                                        <i class="bi bi-person-check" aria-hidden="true"></i>
                                        Einchecken
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="resource-quick-create-prompt">
                        <span>@(_searchType == ResourceEntityType.Person ? "Person fehlt in der Liste?" : "Hund fehlt in der Liste?")</span>
                        <button type="button"
                                class="btn btn-outline-secondary resource-quick-create-button"
                                @onclick="() => OpenQuickCreate(_searchType)">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                            Schnell erfassen
                        </button>
                    </div>
                </div>
            }

            @if (_showQuickCreate)
            {
                <div class="modal-overlay">
                    <button type="button"
                            class="modal-overlay-dismiss"
                            disabled="@_isSaving"
                            @onclick="CloseQuickCreate"
                            aria-label="Schnellaufnahme schließen"></button>
                    <section class="modal-modern modal-modern--640 resource-quick-create-dialog"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="quick-create-heading"
                             @onclick:stopPropagation="true">
                        <div class="modal-modern-header">
                            <div>
                                <p class="resource-eyebrow">STAMMDATEN UND EINSATZ</p>
                                <h3 id="quick-create-heading">
                                    @(_quickCreateType == ResourceEntityType.Person ? "Person erfassen und einchecken" : "Hund erfassen und einchecken")
                                </h3>
                            </div>
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@_isSaving"
                                    @onclick="CloseQuickCreate"
                                    aria-label="Dialog schließen">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="modal-modern-body">
                            <p class="resource-quick-create-explainer">
                                Der Datensatz wird dauerhaft in den Stammdaten gespeichert und anschließend diesem Einsatz zugewiesen.
                            </p>
                            @if (_quickCreateType == ResourceEntityType.Person)
                            {
                                <div class="resource-quick-create-grid">
                                    <label>
                                        <span>Vorname</span>
                                        <input class="form-control" autocomplete="given-name" @bind="_newPerson.Vorname" />
                                    </label>
                                    <label>
                                        <span>Nachname</span>
                                        <input class="form-control" autocomplete="family-name" @bind="_newPerson.Nachname" />
                                    </label>
                                    <label>
                                        <span>Organisation (optional)</span>
                                        <input class="form-control" @bind="_newPerson.Organisation" />
                                    </label>
                                    <label>
                                        <span>Divera-Benutzer-ID (optional)</span>
                                        <input class="form-control" inputmode="numeric" @bind="_newDiveraUserId" />
                                    </label>
                                </div>
                            }
                            else
                            {
                                <div class="resource-quick-create-grid">
                                    <label>
                                        <span>Name</span>
                                        <input class="form-control" @bind="_newDog.Name" />
                                    </label>
                                    <label>
                                        <span>Rasse (optional)</span>
                                        <input class="form-control" @bind="_newDog.Rasse" />
                                    </label>
                                    <label>
                                        <span>Organisation (optional)</span>
                                        <input class="form-control" @bind="_newDog.Organisation" />
                                    </label>
                                    <label>
                                        <span>Alter in Jahren (optional)</span>
                                        <input class="form-control" type="number" min="0" @bind="_newDog.Alter" />
                                    </label>
                                </div>
                            }
                        </div>
                        <div class="modal-modern-footer">
                            <button type="button"
                                    class="btn btn-primary"
                                    disabled="@_isSaving"
                                    @onclick="CreateAndCheckInAsync">
                                <i class="bi bi-check2" aria-hidden="true"></i>
                                Stammdaten speichern und einchecken
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@_isSaving"
                                    @onclick="CloseQuickCreate">
                                Abbrechen
                            </button>
                        </div>
                    </section>
                </div>
            }
        </section>

        <section class="resource-roster-section" aria-labelledby="roster-heading">
            <div class="resource-section-heading">
                <div>
                    <p class="resource-eyebrow">AKTUELLER EINSATZ</p>
                    <h2 id="roster-heading">Eingecheckte Ressourcen</h2>
                </div>
                <div class="resource-counts" aria-label="@($"{InVerfuegungsraumCount} Ressourcen im Verfügungsraum, {SortedResources.Count} insgesamt")">
                    <strong>@InVerfuegungsraumCount</strong>
                    <span>im Verfügungsraum · @SortedResources.Count gesamt</span>
                </div>
            </div>

            @if (SortedResources.Count == 0)
            {
                <div class="resource-roster-empty">
                    <i class="bi bi-person-check" aria-hidden="true"></i>
                    <span>Noch keine Ressourcen eingecheckt.</span>
                </div>
            }
            else
            {
                <div class="resource-table-wrap">
                    <table class="table resource-table">
                        <thead>
                            <tr>
                                <th scope="col">Ressource</th>
                                <th scope="col">Art</th>
                                <th scope="col">Status</th>
                                <th scope="col">Disposition</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var resource in SortedResources)
                            {
                                <tr @key="ResourceKey(resource)">
                                    <td>
                                        <strong>@ResourceName(resource)</strong>
                                        @if (resource.Status == ResourceStatus.Sonderauftrag && !string.IsNullOrWhiteSpace(resource.SonderauftragNotiz))
                                        {
                                            <small class="resource-assignment-note">@resource.SonderauftragNotiz</small>
                                        }
                                        else if (resource.Status == ResourceStatus.AufAnfahrt && !string.IsNullOrWhiteSpace(resource.DiveraRueckmeldung))
                                        {
                                            <small class="resource-assignment-note">Divera: @resource.DiveraRueckmeldung</small>
                                        }
                                        @if (IsSpecialAssignmentPending(resource))
                                        {
                                            <label class="resource-assignment-note-input">
                                                <span>Auftrag / Zweck (Pflichtfeld)</span>
                                                <input class="form-control form-control-sm"
                                                       value="@PendingNote(resource)"
                                                       @oninput="args => SetPendingNote(resource, args.Value?.ToString())" />
                                            </label>
                                        }
                                    </td>
                                    <td>@(resource.EntityType == ResourceEntityType.Person ? "Person" : "Hund")</td>
                                    <td>
                                        <span class="resource-status @ResourceStatusPresentation.CssClass(resource.Status)">
                                            <i class="bi @ResourceStatusPresentation.Icon(resource.Status)" aria-hidden="true"></i>
                                            @ResourceStatusPresentation.Label(resource.Status)
                                        </span>
                                    </td>
                                    <td>
                                        @if (IsSpecialAssignmentPending(resource))
                                        {
                                            <div class="resource-row-actions">
                                                <button type="button" class="btn btn-sm btn-primary"
                                                        disabled="@_isSaving"
                                                        @onclick="() => ConfirmSpecialAssignmentAsync(resource)">
                                                    Bestätigen
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => CancelSpecialAssignment(resource)">
                                                    Abbrechen
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <select class="form-select resource-status-select"
                                                    aria-label="@($"Status für {ResourceName(resource)} ändern")"
                                                    value="@resource.Status"
                                                    disabled="@_isSaving"
                                                    @onchange="args => OnStatusSelectedAsync(resource, args.Value?.ToString())">
                                                @foreach (var status in StatusOptions(resource.EntityType))
                                                {
                                                <option value="@status">@ResourceStatusPresentation.Label(status)</option>
                                                }
                                            </select>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>
