@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="modal-overlay-dismiss" aria-hidden="true"></div>
        <div class="modal-modern modal-modern--md"
             role="dialog"
             aria-modal="true"
             aria-labelledby="team-mobile-dialog-title"
             @onclick:stopPropagation="true">
            <div class="modal-modern-header bg-success text-white">
                <h3 id="team-mobile-dialog-title" class="mb-0"><i class="bi bi-qr-code me-1" aria-hidden="true"></i>Team-Mobile Anmelde-Code</h3>
                <button class="btn btn-sm btn-outline-light" type="button" aria-label="Dialog schließen" @onclick="OnClose">X</button>
            </div>
            <div class="modal-modern-body text-center">
                @if (AdresseFehlt)
                {
                    <div class="alert alert-warning text-start">
                        <strong>Keine öffentliche Adresse eingetragen.</strong> Der QR-Code braucht die Adresse, unter der eure Teams
                        diesen Server erreichen. Bitte unter <a href="/einstellungen">Einstellungen</a> → Team-Mobile → Basis-URL eintragen.
                    </div>
                }
                else if (string.IsNullOrEmpty(FullUrl))
                {
                    <div class="alert alert-warning">
                        Es ist gerade kein Einsatz aktiv. Starte einen Einsatz, um einen Anmelde-Code zu generieren.
                    </div>
                }
                else
                {
                    <p class="monitor-text-caption mb-2">
                        Teams scannen diesen QR-Code mit dem Smartphone, um sich auf <strong>/team/login</strong> anzumelden.
                    </p>
                    <img src="@QrDataUrl" alt="QR-Code" class="monitor-qr-image" />
                    @if (!string.IsNullOrEmpty(ReadableCode))
                    {
                        @* Zum Vorlesen per Funk oder Abtippen auf /team/login, wenn ein Handy den QR-Code nicht scannt *@
                        <div class="monitor-team-code" aria-label="Anmelde-Code">@ReadableCode</div>
                        <div class="monitor-text-caption">Anmelde-Code – auf <strong>/team/login</strong> eintippen</div>
                    }
                    <div class="mt-3">
                        <input id="team-mobile-url"
                               type="text"
                               class="form-control text-center"
                               aria-label="Anmelde-Adresse"
                               readonly
                               value="@FullUrl"
                               @onclick="SelectUrlAsync" />
                    </div>
                    <p class="monitor-text-caption mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Der Code wird beim Einsatz-Ende automatisch ungültig.
                    </p>
                }
            </div>
            <div class="modal-modern-footer">
                <button class="btn btn-outline-secondary" @onclick="OnClose">Schließen</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string FullUrl { get; set; } = string.Empty;
    [Parameter] public string QrDataUrl { get; set; } = string.Empty;
    [Parameter] public string ReadableCode { get; set; } = string.Empty;
    [Parameter] public bool AdresseFehlt { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task SelectUrlAsync() =>
        JS.InvokeVoidAsync("layoutTools.selectText", "team-mobile-url").AsTask();
}
